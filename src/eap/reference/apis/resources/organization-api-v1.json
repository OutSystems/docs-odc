              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK"
          }
        },
        "x-os-permissions": "API Client needs the **Organization management > Manage Organization** permission for the target environment (stage)."
      }
    },
    "/ip-filter-group": {
      "get": {
        "tags": [
          "Platform IP Filters"
        ],
        "summary": "Retrieves the tenant's current Platform Access IP Filter Group configuration.",
        "description": "Returns the default allow-all configuration when the group is not configured.\n\nAPI Client needs the **Organization management > Manage Organization** permission for the target environment (stage).",
        "operationId": "Organization_GetPlatformIpFilterGroup",
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
